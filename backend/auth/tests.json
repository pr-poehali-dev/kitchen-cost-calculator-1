{
  "tests": [
    {
      "name": "Short password rejected",
      "method": "POST",
      "path": "/?action=register",
      "body": {"login": "newtest99", "password": "short"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Пароль должен быть минимум 8 символов"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Password without digit rejected",
      "method": "POST",
      "path": "/?action=register",
      "body": {"login": "newtest99", "password": "passwordonly"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Пароль должен содержать хотя бы одну цифру"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with wrong password returns 401",
      "method": "POST",
      "path": "/?action=login",
      "body": {"login": "nonexistent_user_xyz", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный логин или пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "verify_password without token returns 401",
      "method": "POST",
      "path": "/?action=verify_password",
      "body": {"password": "somepassword"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Нет токена"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without token",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "expectedBody": {"error": "Нет токена"},
      "bodyMatcher": "partial"
    }
  ]
}